pipeline{
    agent any 
    
    stages{
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Setup Environment'){
            steps{
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install -r requirements.txt
                '''
            }
        }
        stage('Run Tests') {
            steps {
                // Run pytest and output results to an XML file
                bat '''
                . venv/bin/activate
                pytest --junitxml=test-results.xml
                '''
            }
            post {
                always {
                    // This tells Jenkins to parse the XML file and create a test report UI
                    junit 'test-results.xml'
                }
            }
        }
    }
}