pipeline{
    agent any 
    
    stages{
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Setup Environment'){
            steps{
                bat '''
                cd python_test
                C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe -m venv venv
                call venv\\Scripts\\activate.bat
                pip install -r requirements.txt
                '''
            }
        }
        stage('Run Tests') {
            steps {
                // Run pytest and output results to an XML file
                bat '''
                cd python_test
                call venv\\Scripts\\activate.bat
                pytest --junitxml=test-results.xml
                '''
            }
            post {
                always {
                    // This tells Jenkins to parse the XML file and create a test report UI
                    junit 'python_test/test-results.xml'
                }
            }
        }
    }
}